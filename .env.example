# Backend
# Comma-separated list of origins allowed to call the API (CORS)
BACKEND_CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection string for the application database.
# Supabase: Project Settings -> Database -> Connection string -> "Session
# pooler" tab (works over IPv4, recommended for local development). Copy
# the URI, change its "postgresql://" prefix to "postgresql+psycopg://",
# and URL-encode any special characters in the password. See README.md
# for the full walkthrough.
DATABASE_URL=postgresql+psycopg://postgres.CHANGE_ME:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Separate, fully isolated database used only by the automated test suite.
# Tests call Base.metadata.create_all()/drop_all() against this database --
# never point this at Supabase or any database with real data. Recommended:
# the native local PostgreSQL 16 install (see README.md), which keeps
# Supabase completely untouched by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://pitchpilot:CHANGE_ME@localhost:5432/pitchpilot_test

# Frontend (Next.js public env var — exposed to the browser, no secrets here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
